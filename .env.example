# Connection string Neon de la base DEV, sans pooling (Neon > Connect > décocher « Connection pooling »)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/kommit_dev?sslmode=require"

# Secret qui signe les cookies de session Better Auth. À générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL publique du backend
BETTER_AUTH_URL="http://localhost:3000"

# Origins du front autorisées (CORS et Better Auth), séparées par des virgules.
# Vide en local : les ports de Vite 5173 à 5176. En prod, l'URL Vercel du front.
CORS_ORIGINS=""

# Clé API Groq du LLM du daily standup (console.groq.com > API Keys)
GROQ_API_KEY=""
# Modèle Groq, optionnel (défaut : openai/gpt-oss-120b)
# GROQ_MODEL="openai/gpt-oss-120b"
